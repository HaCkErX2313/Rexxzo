# ─── Server & Deployment (e.g. Railway) ─────────────────────────────────────────
PORT=8080
# SPRING_PROFILES_ACTIVE=prod

# ─── Database ─────────────────────────────────────────────────────────────────
# For standard host/port/name setup:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rexxo_db
DB_USERNAME=postgres
DB_PASSWORD=
# Or unified JDBC URL (standard in cloud environments / Railway):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rexxo_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
# FRONTEND_URL=https://rexxzo.vercel.app

# ─── Email Delivery (JavaMail / SMTP) ──────────────────────────────────────────
# For Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587 (Requires a 16-character Google App Password)
# For Brevo / Sendinblue: MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587
# For SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587 (MAIL_USERNAME=apikey)
# For AWS SES: MAIL_HOST=email-smtp.us-east-1.amazonaws.com, MAIL_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@rexxo.com

# ─── SMS Delivery (Fast2SMS / Twilio) ─────────────────────────────────────────
# Provider options: fast2sms, twilio
SMS_PROVIDER=fast2sms
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=REXXO

# ─── OTP Policy & Security ───────────────────────────────────────────────────
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Set OTP_DEV_MODE=false in production (never enable in production!)
OTP_DEV_MODE=false

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Shiprocket ───────────────────────────────────────────────────────────────
# Create a dedicated API user at: Shiprocket Panel -> Settings -> API -> Create API User
# Do NOT use your main Shiprocket login credentials here
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
# Your warehouse/pickup pincode
SHIPROCKET_PICKUP_PINCODE=

# ─── WhatsApp Notifications (Meta Cloud API / Twilio) ─────────────────────────
# When unset, WhatsApp notifications are recorded as DISABLED/PENDING without faking external calls.
WHATSAPP_PROVIDER=META_CLOUD
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
